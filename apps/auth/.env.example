# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database (Postgres) — used for users + OIDC payloads
DATABASE_URL=postgres://auth:auth@localhost:5432/auth

# CORS — Next.js (auth-web) and any client apps
CORS_ORIGIN=http://localhost:3000

# OIDC interaction redirect target (auth-web for login/consent UI)
WEB_URL=http://localhost:3000

# Cookie signing key for OIDC interaction cookies (rotate periodically)
COOKIE_SECRET=replace-me-with-a-long-random-string

# OIDC RSA private key (JWK JSON, single line). Generate with:
#   node -e "const {generateKeyPairSync,createPublicKey}=require('crypto');const {publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048});const jwk=privateKey.export({format:'jwk'});jwk.use='sig';jwk.alg='RS256';console.log(JSON.stringify(jwk))"
OIDC_JWK=
