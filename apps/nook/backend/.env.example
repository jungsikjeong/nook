NODE_ENV=development
# RP 는 4000 번 포트로 뜬다. (IdP=apps/auth 가 3001 을 쓰므로 충돌 회피)
PORT=4000

# PostgreSQL (RP 자체 DB — user/session 캐시용)
DATABASE_URL=postgresql://nook:nook@localhost:5434/nook

# Better Auth RP 공개 URL (기본값: http://localhost:PORT)
BETTER_AUTH_URL=http://localhost:4000

# OIDC (RP → IdP=apps/auth) — seed-oauth-client 로 발급된 값
OIDC_ISSUER=http://localhost:3001/api/auth
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_CALLBACK_URL=http://localhost:4000/api/auth/oauth2/callback/nook-auth

# Better Auth 서명 시크릿 (BETTER_AUTH_SECRET 또는 SESSION_SECRET 중 하나 필수)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-at-least-32-characters

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS (frontend origin) — nook frontend 는 3030 에서 뜬다
CORS_ORIGIN=http://localhost:3030

# nook 프론트엔드 URL — 에러 리다이렉트 대상
FRONTEND_URL=http://localhost:3030
